@model ABCRetail.Models.Order

@{
	var cust = ViewData["Customer"] as List<ABCRetail.Models.Customer>;
	var prod = ViewData["Product"] as List<ABCRetail.Models.Product>;
}

<h1>Summary</h1>

@if (cust == null || cust.Count == 0 || prod == null || prod.Count == 0)
{
	<div class="alert alert-warning" >
		No Customer or product is available. Please ensure that they are added.
	</div>
}
else
{
	<form asp-action="Summary" method="post" >
		<div class="form-group"><label asp-for="cust_ID">Select Customer</label>
			<select asp-for="cust_ID" class="form-control" asp-items="@(new SelectList(cust, "cust_ID", "custName"))">
				<option value="">--Select Customer-- </option>
			</select>
			</div>
			<span asp-validation-for="cust_ID" class="text-danger"></span>
		<div class="form-group">
			<label asp-for="product_ID">Select Product</label>
			<select asp-for="product_ID" class="form-control" asp-items="@(new SelectList(prod, "product_ID", "prodName"))">
				<option value="">--Select Product--</option>
			</select>
		</div>
		<span asp-validation-for="product_ID" class="text-danger"></span>
		<div class="form-group">
			<label asp-for="Order_Location"></label>
			<input asp-for="Order_Location" class="form-control"/>
			<span asp-validation-for="Order_Location" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Order_Date"></label>
			<input asp-for="Order_Date" class="form-control" />
			<span asp-validation-for="Order_Date" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Order_Status"></label>
			<input asp-for="Order_Status" class="form-control" />
			<span asp-validation-for="Order_Status" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-primary">Submit</button>
	</form>
}