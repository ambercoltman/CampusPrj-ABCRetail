@model ABCRetail.Models.Order

<h1>Add New Order</h1>

<form asp-action="AddOrder" method="post">
	<div class="form-group"
		 <label asp-for="Name"></label>
		 <input asp-for="Name" class="form-control"/>
	</div>
	<div class="form-group"
		 <label asp-for="phoneNumber"></label>
		 <input asp-for="phoneNumber" class="form-control"/>
	</div>
	<div class="form-group"
		 <label asp-for="Address"></label>
		 <input asp-for="Address" class="form-control"/>
	</div>
	<div class="form-group"
		 <label asp-for="Orders"></label>
		 <input asp-for="Orders" class="form-control" />
	</div>
	<div class="form-group"
		 <label asp-for="Price"></label>
		 <input asp-for="Price" class="form-control"/>
	</div>
	<div class="form-group"
		 <label asp-for="paymentMethod"></label>
		 <input asp-for="paymentMethod" class="form-control"/>
	</div>
	<div class="form-group"
		 <label asp-for="paymentStatus"></label>
		 <input asp-for="paymentStatus" class="form-control"/>
	</div>
	<button type="submit" class="btn btn-primary">Save</button>
</form>