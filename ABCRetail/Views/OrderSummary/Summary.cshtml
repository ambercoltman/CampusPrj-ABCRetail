@model ABCRetail.Models.OrderSummary

@{
	var customer = ViewData["Customer"] as List<ABCRetail.Models.Customer>;
	var order = ViewData["Order"] as List<ABCRetail.Models.Order>;
	var product = ViewData["Product"] as List<ABCRetail.Models.Product>;
}

<h1>Summary</h1>

@if(customer == null || customer.Count == 0 || order == null || order.Count == 0 || product == null || product.Count == 0)
{
	<div class="alert alert-warning">
		No information available. Please ensure that the related fields have been added first.
	</div>
}
else
{
	<form asp-action="Summary" method="post">
		<div class="form-group">
			<label asp-for="custName"> Select Customer </label>
			<select asp-for="custName" class="form-control"
					asp-items="@(new SelectList(customer, "custName"))">
				<option value=""> Select Customer</option>
			</select>
			<span asp-validation-for="address" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="address"> Select Customer Address </label>
			<select asp-for="address" class="form-control"
					asp-items="@(new SelectList(customer, "address"))">
				<option value=""> Select Customer Address</option>
			</select>
			<span asp-validation-for="address" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="prodName"> Select Product </label>
			<select asp-for="prodName" class="form-control"
					asp-items="@(new SelectList(product, "prodName"))">
				<option value=""> Select Product</option>
			</select>
			<span asp-validation-for="prodName" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Orders"> Select Number of Orders </label>
			<select asp-for="Orders" class="form-control"
					asp-items="@(new SelectList(order, "Orders"))">
				<option value=""> Select Number of Orders</option>
			</select>
			<span asp-validation-for="Orders" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Price"> Select Price </label>
			<select asp-for="Price" class="form-control"
					asp-items="@(new SelectList(product, "Price"))">
				<option value=""> Select Price</option>
			</select>
			<span asp-validation-for="Price" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="paymentStatus"> Select Payment Status </label>
			<select asp-for="paymentStatus" class="form-control"
					asp-items="@(new SelectList(order, "paymentStatus"))">
				<option value=""> Select Payment Status</option>
			</select>
			<span asp-validation-for="paymentStatus" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Availability"> Select Availability </label>
			<select asp-for="Availability" class="form-control"
					asp-items="@(new SelectList(product, "Availability"))">
				<option value=""> Select Availability</option>
			</select>
			<span asp-validation-for="Availability" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-primary">Submit Order Summary</button>
	</form>
}